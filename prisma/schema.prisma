generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}
enum Role {
  ADMIN
  SALES_PERSON
  INSTRUCTOR
  STUDENT
}
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT) 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}