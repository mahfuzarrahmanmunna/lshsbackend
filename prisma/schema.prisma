// LSHS CRM — Lead Management
// Prisma 7.x — datasource URL lives in prisma.config.ts, NOT here

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============ ENUMS ============

enum Role {
  ADMIN
  MANAGER
  SALES_PERSON
  INSTRUCTOR
  STUDENT
}

enum LeadStage {
  NEW
  INITIAL_CONTACT
  FOLLOW_UP
  QUALIFIED
  INTERESTED
  APPLICATION
  BOOKING
  WON
  LOST
}

enum LeadStatus {
  ACTIVE
  CONVERTED
  LOST
  NO_RESPONSE
  NOT_INTERESTED
  INVALID
}

enum LeadTemperature {
  HOT
  WARM
  COLD
}

enum LeadPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum LeadQuality {
  TOP_QUALITY
  HIGH_QUALITY
  MEDIUM_QUALITY
  LOW_QUALITY
  IRRELEVANT
}

enum EducationLevel {
  HIGH_SCHOOL
  DIPLOMA
  BACHELORS
  MASTERS
  PHD
  OTHER
}

enum LeadActivityType {
  CALL
  WHATSAPP
  EMAIL
  SMS
  MEETING
  NOTE
  STATUS_CHANGE
  STAGE_CHANGE
  ASSIGNMENT
  OTHER
}

enum LeadActivityResult {
  CONNECTED
  NO_RESPONSE
  RESPONDED
  INVALID
  PROVIDED_INFORMATION
  OTHER
}

enum FollowUpType {
  CALL
  WHATSAPP
  EMAIL
  SMS
  MEETING
  OTHER
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  MISSED
  CANCELLED
}

enum LostReason {
  NO_RESPONSE
  NOT_INTERESTED
  INVALID_INFO
  DUPLICATE
  PRICE
  OTHER
}

// ============ USER (existing, extended) ============

model User {
  id            Int      @id @default(autoincrement())
  name          String
  firstName     String?
  lastName      String?
  email         String   @unique
  password      String
  role          Role     @default(STUDENT)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  leadsAssigned       Lead[]            @relation("LeadAssignedTo")
  assignmentsAssigned LeadAssignment[]  @relation("AssignmentAssignedTo")
  assignmentsBy       LeadAssignment[]  @relation("AssignmentAssignedBy")
  activities          LeadActivity[]
  followUpsAssigned   LeadFollowUp[]    @relation("FollowUpAssignedTo")
  notes               LeadNote[]
  statusChanges       LeadStatusHistory[]
  stageChanges        LeadStageHistory[]

  @@index([role])
}

// ============ LEAD SOURCE ============

model LeadSource {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]

  @@map("lead_sources")
}

// ============ COURSE (used as Program for CRM sales) ============

model Course {
  id         Int      @id @default(autoincrement())
  title      String
  code       String   @unique
  category   String?
  tuitionFee Decimal? @db.Decimal(10, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  interests LeadProgramInterest[]
  leads     Lead[]

  @@map("courses")
}

// ============ LEAD (restructured) ============

model Lead {
  id          Int       @id @default(autoincrement())
  firstName   String
  lastName    String?
  email       String?
  phone       String?
  country     String?
  city        String?

  sourceId        Int?
  externalLeadId  String?

  highestEducation    EducationLevel?
  jobTitle            String?
  company             String?
  workExperienceYears Int?

  stage        LeadStage      @default(NEW)
  status       LeadStatus     @default(ACTIVE)
  temperature  LeadTemperature?
  priority     LeadPriority?
  quality      LeadQuality?

  assignedToId Int?
  lostReason   LostReason?
  lostNote     String?  @db.Text
  convertedAt  DateTime?

  // Meta Ads / webhook dedup
  facebookLeadId  String? @unique

  // Legacy fields kept for backward compat
  courseId        Int?
  courseInterest  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  source      LeadSource? @relation(fields: [sourceId], references: [id])
  assignedTo  User?        @relation("LeadAssignedTo", fields: [assignedToId], references: [id])
  course      Course?      @relation(fields: [courseId], references: [id])

  assignments      LeadAssignment[]
  activities       LeadActivity[]
  followUps        LeadFollowUp[]
  notes            LeadNote[]
  statusHistory    LeadStatusHistory[]
  stageHistory     LeadStageHistory[]
  programInterests LeadProgramInterest[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([stage])
  @@index([temperature])
  @@index([priority])
  @@index([quality])
  @@index([assignedToId])
  @@index([sourceId])
  @@index([country])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([externalLeadId])

  @@map("leads")
}

// ============ LEAD PROGRAM INTEREST ============

model LeadProgramInterest {
  id        Int      @id @default(autoincrement())
  leadId    Int
  courseId  Int
  createdAt DateTime @default(now())

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([leadId, courseId])
  @@index([courseId])
  @@map("lead_program_interests")
}

// ============ LEAD ASSIGNMENT ============

model LeadAssignment {
  id            Int      @id @default(autoincrement())
  leadId        Int
  assignedToId  Int
  assignedById  Int?
  assignedAt    DateTime @default(now())
  note          String?  @db.Text

  lead       Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User @relation("AssignmentAssignedTo", fields: [assignedToId], references: [id])
  assignedBy User? @relation("AssignmentAssignedBy", fields: [assignedById], references: [id])

  @@index([leadId])
  @@index([assignedToId])
  @@map("lead_assignments")
}

// ============ LEAD ACTIVITY (replaces old Activity) ============

model LeadActivity {
  id              Int      @id @default(autoincrement())
  leadId          Int
  userId          Int?
  type            LeadActivityType
  result          LeadActivityResult?
  description     String?  @db.Text
  durationSeconds  Int?
  metadata        Json?
  createdAt       DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("lead_activities")
}

// ============ LEAD FOLLOW-UP (replaces old Task) ============

model LeadFollowUp {
  id              Int      @id @default(autoincrement())
  leadId          Int
  assignedToId    Int?
  followUpNumber  Int
  type            FollowUpType    @default(CALL)
  scheduledAt     DateTime
  nextFollowUpAt DateTime?
  completedAt     DateTime?
  status          FollowUpStatus @default(PENDING)
  outcome         String?  @db.Text
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lead       Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("FollowUpAssignedTo", fields: [assignedToId], references: [id])

  @@unique([leadId, followUpNumber])
  @@index([leadId])
  @@index([assignedToId])
  @@index([status])
  @@index([scheduledAt])
  @@map("lead_follow_ups")
}

// ============ LEAD NOTE ============

model LeadNote {
  id        Int      @id @default(autoincrement())
  leadId    Int
  userId    Int?
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@map("lead_notes")
}

// ============ LEAD STATUS HISTORY ============

model LeadStatusHistory {
  id           Int      @id @default(autoincrement())
  leadId       Int
  oldStatus    LeadStatus?
  newStatus    LeadStatus
  changedById  Int?
  reason       String?  @db.Text
  lostReason   LostReason?
  lostNote     String?  @db.Text
  createdAt    DateTime @default(now())

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy  User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([newStatus])
  @@map("lead_status_history")
}

// ============ LEAD STAGE HISTORY ============

model LeadStageHistory {
  id           Int      @id @default(autoincrement())
  leadId       Int
  oldStage     LeadStage?
  newStage     LeadStage
  changedById  Int?
  reason       String?  @db.Text
  createdAt    DateTime @default(now())

  lead       Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy  User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([newStage])
  @@map("lead_stage_history")
}